{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled main WebView can express bounded user intent. The Rust host owns the key, network, file scope and approvals.",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-app-status",
    "allow-configure-meta-credential",
    "allow-remove-meta-credential",
    "allow-accept-contributor-terms",
    "allow-configure-budget",
    "allow-reconcile-budget",
    "allow-list-conversations",
    "allow-create-conversation",
    "allow-load-conversation",
    "allow-delete-conversation",
    "allow-send-message",
    "allow-cancel-message"
  ]
}
