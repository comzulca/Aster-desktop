{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled main WebView can express bounded user intent. The Rust host owns the key, network, file scope and approvals.",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-app-status",
    "allow-configure-meta-credential",
    "allow-remove-meta-credential",
    "allow-verify-meta-credential",
    "allow-get-personalization",
    "allow-save-personalization",
    "allow-clear-personalization",
    "allow-get-customization",
    "allow-get-customization-package",
    "allow-save-customization",
    "allow-set-customization-enabled",
    "allow-import-customization",
    "allow-generate-customization",
    "allow-get-github-status",
    "allow-begin-github-connection",
    "allow-poll-github-connection",
    "allow-cancel-github-connection",
    "allow-disconnect-github",
    "allow-list-github-repositories",
    "allow-select-github-repository",
    "allow-read-github-file",
    "allow-record-render-event",
    "allow-get-render-trace",
    "allow-accept-contributor-terms",
    "allow-configure-budget",
    "allow-reconcile-budget",
    "allow-list-conversations",
    "allow-create-conversation",
    "allow-load-conversation",
    "allow-delete-conversation",
    "allow-send-message",
    "allow-cancel-message",
    "allow-window-action",
    "allow-startup-shell-ready",
    "allow-select-attachments",
    "allow-remove-attachment",
    "allow-review-processed-attachment"
  ]
}
