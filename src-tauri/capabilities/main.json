{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled main WebView can express bounded user intent. The Rust host owns the key, network, file scope and approvals.",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-app-status",
    "allow-configure-nvidia-credential",
    "allow-remove-nvidia-credential",
    "allow-select-project-root",
    "allow-send-message",
    "allow-cancel-message"
  ]
}
