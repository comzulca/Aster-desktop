{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aster Desktop",
  "version": "0.2.4",
  "identifier": "com.comzulca.aster-desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Aster Desktop",
      "width": 1280,
      "height": 800,
      "minWidth": 960,
      "minHeight": 640,
      "resizable": true,
      "decorations": false,
      "visible": false,
      "backgroundColor": "#1b1f20",
      "theme": "Dark",
      "zoomHotkeysEnabled": false
    }],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "compression": "none"
      }
    },
    "resources": {
      "../reports/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../LICENSE": "LICENSE.txt",
      "resources/aster-builder/SKILL.md": "aster-builder/SKILL.md",
      "resources/aster-builder/references/architecture.md": "aster-builder/references/architecture.md",
      "resources/aster-builder/references/spec-threats.md": "aster-builder/references/spec-threats.md",
      "resources/aster-builder/references/provider-contracts.md": "aster-builder/references/provider-contracts.md",
      "resources/aster-builder/references/storage-tools.md": "aster-builder/references/storage-tools.md",
      "resources/aster-builder/references/ui.md": "aster-builder/references/ui.md",
      "resources/aster-builder/references/verification.md": "aster-builder/references/verification.md",
      "resources/aster-builder/references/aster-case-study.md": "aster-builder/references/aster-case-study.md",
      "resources/aster-builder/references/ledger-schema.md": "aster-builder/references/ledger-schema.md",
      "resources/aster-builder/assets/icon.svg": "aster-builder/assets/icon.svg"
    },
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
