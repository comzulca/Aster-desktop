  "requirements": [
    {
      "id": "PR-001",
      "text": "Target a local Windows 11 Tauri/Rust host and React/TypeScript renderer; the requested Windows checkout path is configurable deployment context, not source code."
    },
    {
      "id": "PR-002",
      "text": "Repository `comzulca/Aster-desktop` is private, with verified owner/collaborator roles and source revision."
    },
    {
      "id": "FR-001",
      "text": "Closed catalog selects exact two NVIDIA model IDs; Nemotron is the initial default."
    },
    {
      "id": "FR-002",
      "text": "Stream both providers through separately validated adapters and safe text rendering."
    },
    {
      "id": "FR-003",
      "text": "Cancel and finish each request exactly once; handle duplicate/out-of-order/framing errors."
    },
    {
      "id": "FR-004",
      "text": "Present accurate unconfigured, ready, sending, cancelled, failure and recovery states."
    },
    {
      "id": "FR-005",
      "text": "User selects a project root through a native host-controlled dialog; no default root."
    },
    {
      "id": "FR-006",
      "text": "Permit bounded UTF-8 project reads solely within a granted and revalidated root."
    },
    {
      "id": "FR-007",
      "text": "Present a bounded, typed, exact-diff proposal without giving a model write authority."
    },
    {
      "id": "FR-008",
      "text": "After separate exact confirmation, support conflict-checked new-file creation only when native Windows safety/recovery is proven."
    },
    {
      "id": "FR-009",
      "text": "Support existing-file replacement only after equivalent native Windows race/crash/recovery proof; otherwise remain proposal-only."
    },
    {
      "id": "FR-010",
      "text": "Keep chat state in process memory for the session; clear it on app restart."
    },
    {
      "id": "FR-011",
      "text": "Provision/read/delete NVIDIA credential with trusted native Windows UI and host-side Credential Manager calls."
    },
    {
      "id": "FR-012",
      "text": "Disable shell, browser, arbitrary network, MCP, and model-provided tool names or URLs in v0.1.0."
    },
    {
      "id": "UX-001",
      "text": "Use original 1917×1137 JPG as the dark Aster visual reference, with compact-window adaptation."
    },
    {
      "id": "UX-002",
      "text": "Provide keyboard navigation, visible focus, named controls, readable status, safe stream announcements, and Spanish user-facing copy."
    },
    {
      "id": "NFR-001",
      "text": "Version policy and host state machine so fixed fixtures produce repeatable decisions and exactly one terminal outcome."
    },
    {
      "id": "NFR-002",
      "text": "Apply time, size, request, stream, file and proposal ceilings and fail closed on exceeded limits."
    },
    {
      "id": "NFR-003",
      "text": "Bind engineering quality, secret/dependency scans, Windows target tests, SBOM and release claims to an exact revision/artifact."
    },
    {
      "id": "SEC-001",
      "text": "Credential bytes never pass through renderer/ordinary IPC, logs, repository or model context."
    },
    {
      "id": "SEC-002",
      "text": "Host authenticates caller and independently validates typed, bounded IPC against a closed window/command permission map."
    },
    {
      "id": "SEC-003",
      "text": "Live egress allows only fixed NVIDIA HTTPS destination and selected pair; no redirect, unintended proxy, silent retry or fallback."
    },
    {
      "id": "SEC-004",
      "text": "All file grants bind root identity, conversation, request, resource, operation, expiry and uses; reject aliases and escape attempts."
    },
    {
      "id": "SEC-005",
      "text": "A model cannot approve a proposal; one human confirmation applies once to one exact change and cannot be replayed."
    },
    {
      "id": "SEC-006",
      "text": "Publication rechecks root/parent/target identity and old hash, journals intent, verifies outcome, and fails closed on conflict/crash."
    },
    {
      "id": "SEC-007",
      "text": "Prompt/project contents are disclosed to NVIDIA only by explicit user request; logs redact keys and private content."
    },
    {
      "id": "SEC-008",
      "text": "No persistent local chat history or unapproved import/export for v0.1.0."
    },
    {
      "id": "SEC-009",
      "text": "Dependencies, secrets, licenses and release artifacts have independent quality evidence; CI is not a live canary."
    }
  ],
